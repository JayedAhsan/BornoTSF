/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_BORNO_TRAY MENU
BEGIN
    POPUP "BornoTSFMenu"
    BEGIN
        POPUP "Keyboard Layout"
        BEGIN
            MENUITEM "Borno Phonetic",   ID_PHONETICLAYOUT_BORNOPHONETIC
            MENUITEM "Avro Phonetic",    ID_PHONETICLAYOUT_AVROPHONETIC
            MENUITEM "Khipro",           ID_PHONETICLAYOUT_KHIPRO
            MENUITEM SEPARATOR
            MENUITEM "Jatiyo",           ID_KEYBOARDLAYOUT_JATIYO
            MENUITEM "Probhat",          ID_KEYBOARDLAYOUT_PROBHAT
        END
        MENUITEM "Settings...",                 MENU_ITEM_ID_SETTINGS
        MENUITEM "Keymap",           MENU_ITEM_ID_KEYMAP
        MENUITEM "Get Borno Regular",           MENU_ITEM_ID_GET_BORNO
        MENUITEM SEPARATOR
        MENUITEM "About BornoTSF",              MENU_ITEM_ID_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_SETTINGS DIALOGEX 0, 0, 220, 185
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "BornoTSF Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Enabled Layouts (Language Bar)",IDC_STATIC,10,10,200,90
    CONTROL         "Borno Phonetic",IDC_CHK_BORNO_PHONETIC,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,25,170,10
    CONTROL         "Avro Phonetic",IDC_CHK_AVRO_PHONETIC,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,40,170,10
    CONTROL         "Khipro",IDC_CHK_KHIPRO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,55,170,10
    CONTROL         "Jatiyo",IDC_CHK_JATIYO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,70,170,10
    CONTROL         "Probhat",IDC_CHK_PROBHAT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,85,170,10

    GROUPBOX        "Quick Settings",IDC_STATIC,10,105,200,45
    CONTROL         "Phonetic Auto Correction",IDC_CHK_PHONETIC_CORRECTION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,118,170,10
    CONTROL         "Traditional Typing Style",IDC_CHK_TYPING_STYLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,133,170,10

    PUSHBUTTON      "Borno Regular",IDC_BTN_GET_BORNO,10,160,55,14
    PUSHBUTTON      "About...",IDC_BTN_ABOUT,70,160,40,14
    DEFPUSHBUTTON   "OK",IDOK,115,160,45,14
    PUSHBUTTON      "Cancel",IDCANCEL,165,160,45,14
END

IDD_ABOUT DIALOGEX 0, 0, 230, 145
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Borno TSF"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDIS_BornoTSF,IDC_STATIC,15,15,20,20
    LTEXT           "Borno TSF",IDC_STATIC,45,15,170,10,SS_NOPREFIX
    LTEXT           "Maintainer: Jayed Ahsan Saad",IDC_STATIC,45,28,170,10
    LTEXT           "Licensed under GNU GPL 3.0",IDC_STATIC,45,41,170,10
    LTEXT           "Open Source IME for Windows OS",IDC_STATIC,45,54,170,10

    PUSHBUTTON      "GitHub Repository",IDC_BTN_GITHUB,20,80,90,14
    PUSHBUTTON      "Check for Updates",IDC_BTN_CHECK_UPDATES,120,80,90,14

    DEFPUSHBUTTON   "OK",IDOK,90,115,50,14
END

